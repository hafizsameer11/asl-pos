# Set to 1 to hit the Nest POS APIs instead of the in-browser Zustand demo DB.
VITE_POS_LIVE=1

# Till surface (proxied by Vite in dev — see vite.config.ts)
VITE_API_BASE=/api/v1/pos

# Admin POS console APIs
VITE_ADMIN_API_BASE=/api/v1/admin/pos

# Backend origin for the Vite proxy (dev only)
VITE_PROXY_TARGET=http://127.0.0.1:3000
